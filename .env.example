# Backend API base URL, ending in /api/v1 (ask the backend team; keep real addresses in .env.local only).
# Leave empty to run entirely on the snapshot and browser mocks.
TOON_API_BASE_URL=

# Which areas use the real API, comma-separated (see docs/api/PHASES.md):
#   reading, accounts, readerActions, money, studio   (or "all")
# Areas left out keep using the snapshot / mocks.
TOON_API_LIVE=

# Set to 1 to open the developer API status page (/dev/api) in a production build.
TOON_DEV_PAGES=
